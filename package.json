{
  "name": "direct-booking-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "ical.js": "^2.1.0",
    "ics": "^3.7.6",
    "jose": "^5.9.3",
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.38.1",
    "stripe": "^16.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
