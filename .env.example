# Database — for local dev, sqlite works out of the box.
# For production, use a real Postgres URL (Supabase, Neon, Railway, RDS, etc)
DATABASE_URL="file:./dev.db"

# Auth — admin dashboard login
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""   # generate with: node scripts/hash-password.js "yourpassword"
SESSION_SECRET="change-this-to-a-long-random-string"

# Image uploads — from vercel.com dashboard → Storage → Blob → Create,
# or `npx vercel link` then `npx vercel env pull` if deploying on Vercel.
# Leave blank and the admin form still accepts pasted image URLs instead.
BLOB_READ_WRITE_TOKEN=""

# Stripe — leave blank to run in "Request to Book" (inquiry) mode instead of live payments
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Resend) — leave blank to skip sending confirmation emails (logged to console instead)
RESEND_API_KEY=""
NOTIFY_EMAIL="owner@example.com"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Marrow & Pine Stays"
