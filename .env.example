# Copy to .env for local development. In production, set these in your host's
# dashboard (Vercel → Settings → Environment Variables). Never commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, RDS, local Postgres…).
# Tables are created/updated automatically by `npm run build` (scripts/migrate.mjs).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin dashboard login (/admin/login)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""   # generate with: node scripts/hash-password.js "yourpassword"
# 32+ random characters. Admin login is disabled in production without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # your real https:// URL in production (no trailing slash)
NEXT_PUBLIC_SITE_NAME="Marrow & Pine Stays"

# ── Optional: online payments (Stripe) ──────────────────────────────────────
# Leave blank to run in "Request to Book" mode (no payment collected online).
# Online payments also unlock the non-refundable rate and automatic monthly
# billing for 30+ night stays. See /admin/stripe-setup.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""   # required whenever STRIPE_SECRET_KEY is set
# Protects the daily job (/api/cron/daily) that places, renews, and releases
# security deposit holds. 16+ random characters; required with Stripe.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ── Optional: email (Resend) ────────────────────────────────────────────────
# Leave blank and emails are written to the server log instead of sent.
RESEND_API_KEY=""
NOTIFY_EMAIL="owner@example.com"   # receives new-booking, cancellation, and payment alerts
EMAIL_FROM=""                      # e.g. "Marrow & Pine <bookings@yourdomain.com>" (domain must be verified in Resend)

# ── Optional: photo uploads (Vercel Blob) ───────────────────────────────────
# Leave blank and the admin form still accepts pasted image URLs.
BLOB_READ_WRITE_TOKEN=""
