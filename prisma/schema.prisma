// Prisma schema — PostgreSQL in every environment (local, preview, production).
// Schema changes ship as SQL files in prisma/migrations and are applied by
// `npm run db:migrate` (which `npm run build` runs automatically).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  address     String
  city        String
  state       String
  country     String   @default("US")
  maxGuests   Int
  bedrooms    Int
  beds        Int
  baths       Float
  basePrice   Int      // nightly rate, in cents
  cleaningFee Int      @default(0) // cents
  taxRate     Float    @default(0) // e.g. 0.08 for 8%
  minNights   Int      @default(2)
  minPrice    Int?     // cents — smart pricing floor (never charge less than this per night)
  maxPrice    Int?     // cents — smart pricing ceiling (never charge more than this per night)
  amenities   String   // JSON array string, e.g. ["WiFi","Kitchen","Pool"]
  images      String   // JSON array string of image URLs, first = cover
  houseRules  String?  // Markdown/text — house rules for guests
  welcomeGuide String? // Markdown/text — local tips, restaurants, entertainment
  active      Boolean  @default(true)
  smartPricingEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings      Booking[]
  blockedDates  BlockedDate[]
  priceRules    PriceRule[]
  icalSources   IcalSource[]
  smartPricing  SmartPricingRule[]
}

model Booking {
  id           String        @id @default(cuid())
  property     Property      @relation(fields: [propertyId], references: [id])
  propertyId   String
  guestName    String
  guestEmail   String
  guestPhone   String?
  checkIn      DateTime
  checkOut     DateTime
  guests       Int
  nights       Int
  subtotal     Int           // cents
  cleaningFee  Int           // cents
  taxTotal     Int           // cents
  total        Int           // cents
  status       BookingStatus @default(PENDING)
  paymentType  PaymentType   @default(INQUIRY)
  stripeSessionId String?
  stripeSubscriptionId String?  // for recurring monthly payments
  stripePaymentIntentId String? // one-time payments (used for refunds)
  stripeCustomerId      String? // Stripe customer holding the guest's saved card
  stripePaymentMethodId String? // saved card (set by the save-card flow; otherwise read from the first payment)
  cardRequestedAt       DateTime? // host asked the guest to save a card

  // Refundable security deposit hold (authorization only, Terms §5)
  depositAmount          Int?           // cents agreed at booking (null = no hold for this booking)
  depositStatus          DepositStatus? // null when depositAmount is null
  depositPaymentIntentId String?        // current authorization
  depositHeldUntil       DateTime?      // when the current authorization expires
  depositCapturedAmount  Int            @default(0)
  depositAttempts        Int            @default(0)  // used for Stripe idempotency keys
  depositNote            String?
  monthlyAmount    Int?         // cents charged per full month, incl. tax (null = one-time payment)
  totalPayments    Int?         // total number of monthly payments
  proratedFinal    Int?         // cents for the final prorated payment, incl. tax (null if none)
  paymentSchedule  String?      // JSON [{label, amount}] — exactly what the guest agreed to

  // Cancellation policy the guest chose/agreed to at booking time
  cancellationPolicy CancellationPolicy @default(MODERATE)
  discountAmount   Int          @default(0) // cents off the nightly subtotal (non-refundable / long-stay)
  discountLabel    String?
  termsVersion     String?      // version of /terms the guest accepted
  termsAcceptedAt  DateTime?

  // Cancellation outcome
  cancelledAt      DateTime?
  cancelledBy      String?      // "GUEST" | "HOST"
  refundAmount     Int?         // cents refunded to the guest
  cancellationNote String?

  notes        String?
  messageToken String?       @unique // token for guest to access messages/manage booking without login
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages     Message[]
  payments     Payment[]
  damageClaims DamageClaim[]
}

// Post-checkout damage claims (Terms §5). Kept separate from Payment, which
// only holds stay payments and drives cancellation refunds.
model DamageClaim {
  id                    String            @id @default(cuid())
  booking               Booking           @relation(fields: [bookingId], references: [id])
  bookingId             String
  amount                Int               // cents
  description           String
  photoUrls             String            // JSON array of image URLs
  status                DamageClaimStatus @default(NOTICE_SENT)
  noticeSentAt          DateTime          @default(now())
  chargeAfter           DateTime          // earliest time the card may be charged
  stripePaymentIntentId String?
  fromDepositAmount     Int               @default(0) // cents taken from the security hold
  failureReason         String?
  chargedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([bookingId])
}

enum DepositStatus {
  SCHEDULED  // waiting until shortly before check-in
  PLACING    // authorization in progress (short-lived lock)
  HELD       // authorized on the guest's card
  RENEWING   // replacing an expiring authorization (short-lived lock)
  CAPTURING  // being used for a damage charge (short-lived lock)
  FAILED     // couldn't be placed or expired; guest asked for a working card
  CAPTURED   // used (fully or partly) for damages; any remainder released by Stripe
  RELEASED   // released, or no longer needed
}

enum DamageClaimStatus {
  NOTICE_SENT        // guest notified; waiting for the notice period to end
  CHARGING           // charge in progress (short-lived lock)
  CHARGED            // saved card charged successfully
  PAYMENT_LINK_SENT  // card couldn't be charged; guest emailed a payment link
  PAID               // guest paid through the link
  CANCELLED          // host withdrew the claim
}

// Every successful charge for a booking (one-time payment, each monthly
// installment, or a cancellation shortfall). stripeRef is the Stripe invoice
// id (subscriptions) or payment intent id (one-time) — unique, so webhook
// retries never double-count a payment.
model Payment {
  id                    String   @id @default(cuid())
  booking               Booking  @relation(fields: [bookingId], references: [id])
  bookingId             String
  stripeRef             String   @unique
  stripePaymentIntentId String?
  kind                  String   // "ONE_TIME" | "INSTALLMENT" | "SHORTFALL"
  amount                Int      // cents
  refundedAmount        Int      @default(0)
  paidAt                DateTime @default(now())

  @@index([bookingId])
}

enum CancellationPolicy {
  MODERATE        // stays < 30 nights, standard rate
  NON_REFUNDABLE  // stays < 30 nights, discounted rate, no refund after 24h grace
  LONG_TERM_FIRM  // stays >= 30 nights, monthly billing
}

// Failed admin login attempts, used for rate limiting.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Messages between host and guest for a specific booking
model Message {
  id        String      @id @default(cuid())
  booking   Booking     @relation(fields: [bookingId], references: [id])
  bookingId String
  sender    MessageSender
  text      String
  createdAt DateTime    @default(now())
}

enum MessageSender {
  GUEST
  HOST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentType {
  INQUIRY
  STRIPE
  STRIPE_RECURRING  // monthly subscription payments
}

// Manually blocked dates (host closes dates, or maintenance, etc)
model BlockedDate {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  date       DateTime
  source     String   @default("manual") // "manual" or the ical source name
  createdAt  DateTime @default(now())

  @@unique([propertyId, date, source])
}

// Seasonal / date-range price overrides
model PriceRule {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  startDate  DateTime
  endDate    DateTime
  price      Int      // cents per night for this range
  label      String?  // e.g. "Summer peak"
}

// External calendars to import (Airbnb/VRBO .ics export URLs) so this
// site never shows dates as available when they're booked elsewhere.
model IcalSource {
  id          String    @id @default(cuid())
  property    Property  @relation(fields: [propertyId], references: [id])
  propertyId  String
  label       String    // e.g. "Airbnb"
  url         String
  lastSyncAt  DateTime?
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Smart pricing rules — dynamic adjustments based on demand signals
model SmartPricingRule {
  id         String            @id @default(cuid())
  property   Property          @relation(fields: [propertyId], references: [id])
  propertyId String
  ruleType   SmartPricingType
  // Day-of-week: "0,5,6" for Sun,Fri,Sat — comma-separated day numbers
  // Last-minute: days before check-in threshold
  // Far-out: days before check-in threshold
  // Occupancy: percentage threshold (e.g. 80 = when 80%+ of month is booked)
  threshold  String?
  adjustment Int              // percentage adjustment, e.g. 20 = +20%, -15 = -15%
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
}

enum SmartPricingType {
  DAY_OF_WEEK     // weekend/weekday pricing
  LAST_MINUTE     // discount when close to check-in and still unbooked
  FAR_OUT         // discount for bookings far in advance
  HIGH_DEMAND     // increase when occupancy is high for that period
  LOW_DEMAND      // decrease when occupancy is low
}
