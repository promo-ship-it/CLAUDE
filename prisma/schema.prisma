// Prisma schema — works with SQLite locally, switch DATABASE_URL to a
// Postgres connection string for production (no code changes needed).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // sqlite for local dev, postgresql for production (Vercel/Neon)
  url      = env("DATABASE_URL")
}

model Property {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  address     String
  city        String
  state       String
  country     String   @default("US")
  maxGuests   Int
  bedrooms    Int
  beds        Int
  baths       Float
  basePrice   Int      // nightly rate, in cents
  cleaningFee Int      @default(0) // cents
  taxRate     Float    @default(0) // e.g. 0.08 for 8%
  minNights   Int      @default(2)
  minPrice    Int?     // cents — smart pricing floor (never charge less than this per night)
  maxPrice    Int?     // cents — smart pricing ceiling (never charge more than this per night)
  amenities   String   // JSON array string, e.g. ["WiFi","Kitchen","Pool"]
  images      String   // JSON array string of image URLs, first = cover
  active      Boolean  @default(true)
  smartPricingEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings      Booking[]
  blockedDates  BlockedDate[]
  priceRules    PriceRule[]
  icalSources   IcalSource[]
  smartPricing  SmartPricingRule[]
}

model Booking {
  id           String        @id @default(cuid())
  property     Property      @relation(fields: [propertyId], references: [id])
  propertyId   String
  guestName    String
  guestEmail   String
  guestPhone   String?
  checkIn      DateTime
  checkOut     DateTime
  guests       Int
  nights       Int
  subtotal     Int           // cents
  cleaningFee  Int           // cents
  taxTotal     Int           // cents
  total        Int           // cents
  status       BookingStatus @default(PENDING)
  paymentType  PaymentType   @default(INQUIRY)
  stripeSessionId String?
  stripeSubscriptionId String?  // for recurring monthly payments
  monthlyAmount    Int?         // cents per month (null = one-time payment)
  totalPayments    Int?         // total number of monthly payments
  proratedFinal    Int?         // cents for the final prorated payment (null if evenly divisible)
  notes        String?
  messageToken String?       @unique // token for guest to access messages without login
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages     Message[]
}

// Messages between host and guest for a specific booking
model Message {
  id        String      @id @default(cuid())
  booking   Booking     @relation(fields: [bookingId], references: [id])
  bookingId String
  sender    MessageSender
  text      String
  createdAt DateTime    @default(now())
}

enum MessageSender {
  GUEST
  HOST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentType {
  INQUIRY
  STRIPE
  STRIPE_RECURRING  // monthly subscription payments
}

// Manually blocked dates (host closes dates, or maintenance, etc)
model BlockedDate {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  date       DateTime
  source     String   @default("manual") // "manual" or the ical source name
  createdAt  DateTime @default(now())

  @@unique([propertyId, date, source])
}

// Seasonal / date-range price overrides
model PriceRule {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  startDate  DateTime
  endDate    DateTime
  price      Int      // cents per night for this range
  label      String?  // e.g. "Summer peak"
}

// External calendars to import (Airbnb/VRBO .ics export URLs) so this
// site never shows dates as available when they're booked elsewhere.
model IcalSource {
  id          String    @id @default(cuid())
  property    Property  @relation(fields: [propertyId], references: [id])
  propertyId  String
  label       String    // e.g. "Airbnb"
  url         String
  lastSyncAt  DateTime?
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Smart pricing rules — dynamic adjustments based on demand signals
model SmartPricingRule {
  id         String            @id @default(cuid())
  property   Property          @relation(fields: [propertyId], references: [id])
  propertyId String
  ruleType   SmartPricingType
  // Day-of-week: "0,5,6" for Sun,Fri,Sat — comma-separated day numbers
  // Last-minute: days before check-in threshold
  // Far-out: days before check-in threshold
  // Occupancy: percentage threshold (e.g. 80 = when 80%+ of month is booked)
  threshold  String?
  adjustment Int              // percentage adjustment, e.g. 20 = +20%, -15 = -15%
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
}

enum SmartPricingType {
  DAY_OF_WEEK     // weekend/weekday pricing
  LAST_MINUTE     // discount when close to check-in and still unbooked
  FAR_OUT         // discount for bookings far in advance
  HIGH_DEMAND     // increase when occupancy is high for that period
  LOW_DEMAND      // decrease when occupancy is low
}
